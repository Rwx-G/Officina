    {"name": "work order in its project's folder, the prompt one argument after the separator", "input": {"floor": "schema = 2\n[[project]]\nname = \"backend\"\npath = \"work/Backend\"\n[[template]]\nname = \"dependency-bump\"\ndescription = \"Bump one dependency and fix what breaks\"\nprojects = [\"backend\"]\nprompt = \"Bump {package}, then commit: é ü.\\n-x \\\"quoted\\\" and 'single'\\ttab, 100% & | < > ^ ! $HOME *.txt\\n--bg -- --model opus\\nC:\\\\path\\\\to\\\\dir\\\\\"\nmodel = \"sonnet\"\n[template.params.package]\nvalues = [\"serde_json\", \"@scope/pkg\"]\n[[template]]\nname = \"release-notes\"\ndescription = \"Draft the release notes\"\nprojects = [\"backend\"]\nprompt = \"Draft the release notes for {version}.\"\n[template.params.version]\nvalues = [\"v0.5.0\"]\n", "floor_path": "C:/path/to/floor/officina.toml", "template": "dependency-bump", "project": "backend", "values": [["package", "serde_json"]], "seq": 7, "config_dir": "C:/path/to/claude-work"}, "expect": {"kind": "work_order", "args": ["--bg", "--name", "dependency-bump-7", "--model", "sonnet", "--", "Bump serde_json, then commit: é ü.\n-x \"quoted\" and 'single'\ttab, 100% & | < > ^ ! $HOME *.txt\n--bg -- --model opus\nC:\\path\\to\\dir\\"], "cwd": {"rule": "project", "folder": "C:/path/to/floor/work/Backend"}, "console": "none", "stdin": "null", "capture": {"stdout_cap": 65536, "stderr_cap": 65536}, "deadline_ms": 60000, "env_set": [["NoDefaultCurrentDirectoryInExePath", "1"], ["CLAUDE_CONFIG_DIR", "C:/path/to/claude-work"]], "env_rule": "session"}},
    {"name": "work order of a template naming no model, without a config dir", "input": {"floor": "schema = 2\n[[project]]\nname = \"backend\"\npath = \"work/Backend\"\n[[template]]\nname = \"dependency-bump\"\ndescription = \"Bump one dependency and fix what breaks\"\nprojects = [\"backend\"]\nprompt = \"Bump {package}, then commit: é ü.\\n-x \\\"quoted\\\" and 'single'\\ttab, 100% & | < > ^ ! $HOME *.txt\\n--bg -- --model opus\\nC:\\\\path\\\\to\\\\dir\\\\\"\nmodel = \"sonnet\"\n[template.params.package]\nvalues = [\"serde_json\", \"@scope/pkg\"]\n[[template]]\nname = \"release-notes\"\ndescription = \"Draft the release notes\"\nprojects = [\"backend\"]\nprompt = \"Draft the release notes for {version}.\"\n[template.params.version]\nvalues = [\"v0.5.0\"]\n", "floor_path": "C:/path/to/floor/officina.toml", "template": "release-notes", "project": "backend", "values": [["version", "v0.5.0"]], "seq": 1, "config_dir": null}, "expect": {"kind": "work_order", "args": ["--bg", "--name", "release-notes-1", "--", "Draft the release notes for v0.5.0."], "cwd": {"rule": "project", "folder": "C:/path/to/floor/work/Backend"}, "console": "none", "stdin": "null", "capture": {"stdout_cap": 65536, "stderr_cap": 65536}, "deadline_ms": 60000, "env_set": [["NoDefaultCurrentDirectoryInExePath", "1"]], "env_rule": "session"}}
