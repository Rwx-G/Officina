{
  "schema": 1,
  "cases": [
    {
      "name": "literal template fills to itself",
      "template": "https://monitoring.example.com/api/v1/health?verbose=1",
      "params": {},
      "expect": {"url": "https://monitoring.example.com/api/v1/health?verbose=1"}
    },
    {
      "name": "a placeholder fills a whole path segment, unreserved bytes kept",
      "template": "https://monitoring.example.com/api/{check}",
      "params": {"check": "node-exporter_v1.2~x"},
      "expect": {"url": "https://monitoring.example.com/api/node-exporter_v1.2~x"}
    },
    {
      "name": "a slash in a value cannot add a segment",
      "template": "https://monitoring.example.com/api/{check}/status",
      "params": {"check": "a/b"},
      "expect": {"url": "https://monitoring.example.com/api/a%2Fb/status"}
    },
    {
      "name": "a placeholder fills a whole query value; & and = cannot add a parameter",
      "template": "https://monitoring.example.com/search?q={q}&limit=10",
      "params": {"q": "x&admin=1"},
      "expect": {"url": "https://monitoring.example.com/search?q=x%26admin%3D1&limit=10"}
    },
    {
      "name": "reserved bytes are encoded: space, ?, #, %, +, :, @",
      "template": "https://monitoring.example.com/{v}",
      "params": {"v": "a b?c#d%e+f:g@h"},
      "expect": {"url": "https://monitoring.example.com/a%20b%3Fc%23d%25e%2Bf%3Ag%40h"}
    },
    {
      "name": "an encoded-looking value is encoded again, never decoded",
      "template": "https://monitoring.example.com/{v}",
      "params": {"v": "%2E%2E"},
      "expect": {"url": "https://monitoring.example.com/%252E%252E"}
    },
    {
      "name": "non-ASCII bytes are encoded one by one",
      "template": "https://monitoring.example.com/hosts/{host}",
      "params": {"host": "café-€"},
      "expect": {"url": "https://monitoring.example.com/hosts/caf%C3%A9-%E2%82%AC"}
    },
    {
      "name": "a backslash is encoded",
      "template": "https://monitoring.example.com/{v}",
      "params": {"v": "a\\b"},
      "expect": {"url": "https://monitoring.example.com/a%5Cb"}
    },
    {
      "name": "port and plain http without a credential",
      "template": "http://10.0.0.10:8080/metrics/{job}",
      "params": {"job": "node"},
      "expect": {"url": "http://10.0.0.10:8080/metrics/node"}
    },
    {
      "name": "IPv6 literal host",
      "template": "https://[::1]:8443/{x}",
      "params": {"x": "y"},
      "expect": {"url": "https://[::1]:8443/y"}
    },
    {
      "name": "a value leading with / is fine in a URL",
      "template": "https://monitoring.example.com/{v}",
      "params": {"v": "/srv/data"},
      "expect": {"url": "https://monitoring.example.com/%2Fsrv%2Fdata"}
    },
    {
      "name": "refused: a leading dash (AD-30)",
      "template": "https://monitoring.example.com/{v}",
      "params": {"v": "-x"},
      "expect": {"refusal": {"kind": "value", "param": "v", "refusal": "leading_dash"}}
    },
    {
      "name": "refused: a dot segment, which a server would resolve",
      "template": "https://monitoring.example.com/api/{v}",
      "params": {"v": ".."},
      "expect": {"refusal": {"kind": "value", "param": "v", "refusal": "dot_segment"}}
    },
    {
      "name": "refused: a control character",
      "template": "https://monitoring.example.com/{v}",
      "params": {"v": "a\r\nHost: x"},
      "expect": {"refusal": {"kind": "value", "param": "v", "refusal": "control_character"}}
    },
    {
      "name": "refused: an invisible formatting character",
      "template": "https://monitoring.example.com/{v}",
      "params": {"v": "a‮b"},
      "expect": {"refusal": {"kind": "value", "param": "v", "refusal": "format_character"}}
    },
    {
      "name": "refused: an empty value",
      "template": "https://monitoring.example.com/?q={v}",
      "params": {"v": ""},
      "expect": {"refusal": {"kind": "value", "param": "v", "refusal": "empty"}}
    },
    {
      "name": "refused: a missing value",
      "template": "https://monitoring.example.com/{v}",
      "params": {},
      "expect": {"refusal": {"kind": "missing_parameter", "param": "v"}}
    },
    {
      "name": "issue: no scheme",
      "template": "monitoring.example.com/api",
      "expect": {"issue": "malformed"}
    },
    {
      "name": "issue: another scheme",
      "template": "ftp://monitoring.example.com/",
      "expect": {"issue": "scheme"}
    },
    {
      "name": "issue: an uppercase scheme",
      "template": "HTTPS://monitoring.example.com/",
      "expect": {"issue": "scheme"}
    },
    {
      "name": "issue: a fragment",
      "template": "https://monitoring.example.com/api#top",
      "expect": {"issue": "fragment"}
    },
    {
      "name": "issue: an unbalanced brace",
      "template": "https://monitoring.example.com/{check",
      "expect": {"issue": "braces"}
    },
    {
      "name": "issue: a placeholder that names no parameter",
      "template": "https://monitoring.example.com/{Check}",
      "expect": {"issue": "braces"}
    },
    {
      "name": "issue: userinfo (D-40)",
      "template": "https://user01:pass@monitoring.example.com/",
      "expect": {"issue": "userinfo"}
    },
    {
      "name": "issue: a placeholder in the host",
      "template": "https://{host}.example.com/",
      "expect": {"issue": "placeholder_in_authority"}
    },
    {
      "name": "issue: a placeholder as the port",
      "template": "https://monitoring.example.com:{port}/",
      "expect": {"issue": "placeholder_in_authority"}
    },
    {
      "name": "issue: an empty host",
      "template": "https:///api",
      "expect": {"issue": "host"}
    },
    {
      "name": "issue: a host with an empty label",
      "template": "https://monitoring..example.com/",
      "expect": {"issue": "host"}
    },
    {
      "name": "issue: a port out of range",
      "template": "https://monitoring.example.com:70000/",
      "expect": {"issue": "port"}
    },
    {
      "name": "issue: an empty port",
      "template": "https://monitoring.example.com:/",
      "expect": {"issue": "port"}
    },
    {
      "name": "issue: a space in a literal",
      "template": "https://monitoring.example.com/a b",
      "expect": {"issue": "invalid_character"}
    },
    {
      "name": "issue: a bad percent escape",
      "template": "https://monitoring.example.com/a%zz",
      "expect": {"issue": "invalid_character"}
    },
    {
      "name": "issue: a placeholder inside a segment",
      "template": "https://monitoring.example.com/v{n}/status",
      "expect": {"issue": "partial_segment"}
    },
    {
      "name": "issue: two placeholders in one segment",
      "template": "https://monitoring.example.com/{a}{b}",
      "expect": {"issue": "partial_segment"}
    },
    {
      "name": "issue: a placeholder as a query key",
      "template": "https://monitoring.example.com/?{key}=1",
      "expect": {"issue": "placeholder_in_query_key"}
    },
    {
      "name": "issue: a placeholder inside a query value",
      "template": "https://monitoring.example.com/?q=prefix-{v}",
      "expect": {"issue": "partial_query_value"}
    },
    {
      "name": "defensive: an @ in a value cannot become userinfo or a host",
      "template": "https://monitoring.example.com/{v}",
      "params": {"v": "user01@evil.example.com"},
      "bound_to": ["monitoring.example.com"],
      "expect": {"url": "https://monitoring.example.com/user01%40evil.example.com"},
      "bound": true
    },
    {
      "name": "defensive: a value of //host cannot become an authority",
      "template": "https://monitoring.example.com/{v}/status",
      "params": {"v": "//evil.example.com/x"},
      "expect": {"url": "https://monitoring.example.com/%2F%2Fevil.example.com%2Fx/status"}
    },
    {
      "name": "defensive: a UNC-like value of backslashes stays one segment",
      "template": "https://monitoring.example.com/{v}",
      "params": {"v": "\\\\evil.example.com\\share"},
      "expect": {"url": "https://monitoring.example.com/%5C%5Cevil.example.com%5Cshare"}
    },
    {
      "name": "defensive: a percent-encoded slash in a value is encoded again",
      "template": "https://monitoring.example.com/api/{v}",
      "params": {"v": "%2F%2Fevil.example.com"},
      "expect": {"url": "https://monitoring.example.com/api/%252F%252Fevil.example.com"}
    },
    {
      "name": "defensive: a half-encoded dot segment in a value is no dot segment",
      "template": "https://monitoring.example.com/api/{v}",
      "params": {"v": ".%2e"},
      "expect": {"url": "https://monitoring.example.com/api/.%252e"}
    },
    {
      "name": "defensive: a whole URL as a value cannot change the scheme, host or port",
      "template": "https://monitoring.example.com/?next={v}",
      "params": {"v": "http://evil.example.com:8080/"},
      "expect": {"url": "https://monitoring.example.com/?next=http%3A%2F%2Fevil.example.com%3A8080%2F"}
    },
    {
      "name": "defensive: a port-looking value stays in its segment",
      "template": "https://monitoring.example.com/{v}",
      "params": {"v": ":8443"},
      "expect": {"url": "https://monitoring.example.com/%3A8443"}
    },
    {
      "name": "defensive: an uppercase host keeps its spelling in the URL and binds as lowercase",
      "template": "https://MONITORING.Example.com/{v}",
      "params": {"v": "x"},
      "bound_to": ["monitoring.example.com"],
      "expect": {"url": "https://MONITORING.Example.com/x"},
      "bound": true
    },
    {
      "name": "defensive: an uppercase credential entry binds the lowercase host",
      "template": "https://monitoring.example.com/x",
      "bound_to": ["Monitoring.EXAMPLE.com"],
      "expect": {"url": "https://monitoring.example.com/x"},
      "bound": true
    },
    {
      "name": "defensive: the port is ignored by the binding",
      "template": "https://monitoring.example.com:8443/x",
      "bound_to": ["monitoring.example.com"],
      "expect": {"url": "https://monitoring.example.com:8443/x"},
      "bound": true
    },
    {
      "name": "defensive: a subdomain of a bound host is not bound",
      "template": "https://api.monitoring.example.com/x",
      "bound_to": ["monitoring.example.com"],
      "expect": {"url": "https://api.monitoring.example.com/x"},
      "bound": false
    },
    {
      "name": "defensive: a host sharing a bound host's suffix is not bound",
      "template": "https://evilmonitoring.example.com/x",
      "bound_to": ["monitoring.example.com"],
      "expect": {"url": "https://evilmonitoring.example.com/x"},
      "bound": false
    },
    {
      "name": "defensive: a credential entry with a port, a wildcard or a trailing dot binds nothing",
      "template": "https://monitoring.example.com/x",
      "bound_to": ["monitoring.example.com:443", "*.example.com", "monitoring.example.com."],
      "expect": {"url": "https://monitoring.example.com/x"},
      "bound": false
    },
    {
      "name": "defensive: a trailing-dot host is refused",
      "template": "https://monitoring.example.com./x",
      "expect": {"issue": "host"}
    },
    {
      "name": "defensive: an IDN host is refused; its punycode form is the one to write",
      "template": "https://bücher.example.com/x",
      "expect": {"issue": "host"}
    },
    {
      "name": "defensive: a punycode host fills and binds as written",
      "template": "https://xn--bcher-kva.example.com/{v}",
      "params": {"v": "x"},
      "bound_to": ["xn--bcher-kva.example.com"],
      "expect": {"url": "https://xn--bcher-kva.example.com/x"},
      "bound": true
    },
    {
      "name": "defensive: a punycode host does not bind a credential entry in Unicode",
      "template": "https://xn--bcher-kva.example.com/x",
      "bound_to": ["bücher.example.com"],
      "expect": {"url": "https://xn--bcher-kva.example.com/x"},
      "bound": false
    },
    {
      "name": "defensive: an IPv6 literal binds its lowercase entry",
      "template": "https://[2001:DB8::1]:8443/{v}",
      "params": {"v": "x"},
      "bound_to": ["[2001:db8::1]"],
      "expect": {"url": "https://[2001:DB8::1]:8443/x"},
      "bound": true
    },
    {
      "name": "defensive: another spelling of the same IPv6 address is not bound",
      "template": "https://[2001:db8:0:0:0:0:0:1]/x",
      "bound_to": ["[2001:db8::1]"],
      "expect": {"url": "https://[2001:db8:0:0:0:0:0:1]/x"},
      "bound": false
    },
    {
      "name": "defensive: an IPv4-mapped IPv6 literal is a host of its own",
      "template": "https://[::ffff:192.0.2.10]/x",
      "bound_to": ["192.0.2.10"],
      "expect": {"url": "https://[::ffff:192.0.2.10]/x"},
      "bound": false
    },
    {
      "name": "defensive: an IPv6 zone is refused",
      "template": "https://[fe80::1%25eth0]/x",
      "expect": {"issue": "host"}
    },
    {
      "name": "defensive: an unclosed IPv6 literal is refused",
      "template": "https://[::1/x",
      "expect": {"issue": "host"}
    },
    {
      "name": "defensive: an encoded @ before the host is still userinfo",
      "template": "https://user01%40x@monitoring.example.com/",
      "expect": {"issue": "userinfo"}
    },
    {
      "name": "defensive: a backslash before an @ is still userinfo",
      "template": "https://monitoring.example.com\\@evil.example.com/",
      "expect": {"issue": "userinfo"}
    },
    {
      "name": "defensive: a backslash in the host is refused",
      "template": "https://monitoring.example.com\\evil/x",
      "expect": {"issue": "host"}
    },
    {
      "name": "defensive: an encoded slash in the host is refused",
      "template": "https://monitoring.example.com%2fevil/x",
      "expect": {"issue": "host"}
    },
    {
      "name": "defensive: a scheme-relative template is malformed",
      "template": "//monitoring.example.com/x",
      "expect": {"issue": "malformed"}
    }
  ]
}
