      "name": "a value of another parameter's list",
      "family": "outside_list",
      "steps": [
        {"issue": {"template": "bump", "project": "backend", "values": [["package", "minor"], ["level", "minor"]], "subject": null}, "expect": {"outcome": "refused", "value": {"kind": "order", "detail": "value_not_in_list"}}}
      ],
      "bg_spawns": 0
    },
