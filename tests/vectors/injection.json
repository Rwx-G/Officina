      "steps": [
        {"issue": {"template": "bump", "project": "elsewhere", "values": [["package", "serde_json"], ["level", "minor"]], "subject": null}, "expect": {"outcome": "refused", "value": {"kind": "order", "detail": "project_not_allowed"}}}
      ],
      "bg_spawns": 0
    },
