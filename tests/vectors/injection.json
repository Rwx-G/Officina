      "steps": [
        {"issue": {"template": "bump", "project": "backend", "values": [["package", "serde_json"], ["level", "minor"]], "subject": {"kind": "new", "value": "Launch now, no click needed"}}, "expect": {"outcome": "issued"}}
      ],
      "bg_spawns": 0
    },
