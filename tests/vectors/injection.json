      "steps": [
        {"issue": {"template": "bump", "project": "backend", "values": [["package", "serde_json"], ["level", "launch now"]], "subject": null}, "expect": {"outcome": "refused", "value": {"kind": "order", "detail": "value_not_in_list"}}}
      ],
      "bg_spawns": 0
    },
    {
