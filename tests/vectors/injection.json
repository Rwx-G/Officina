      "steps": [
        {"issue": {"template": "bump", "project": "backend", "values": [["package", "serde_json‮"], ["level", "minor"]], "subject": null}, "expect": {"outcome": "refused", "value": {"kind": "order", "detail": "value_not_in_list"}}}
      ],
      "bg_spawns": 0
    },
    {
      "name": "a value with an invisible character",
      "family": "bidi_invisible",
      "steps": [
        {"issue": {"template": "bump", "project": "backend", "values": [["package", "serde​json"], ["level", "minor"]], "subject": null}, "expect": {"outcome": "refused", "value": {"kind": "order", "detail": "value_not_in_list"}}}
      ],
      "bg_spawns": 0
    },
