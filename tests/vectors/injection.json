      "family": "outside_list",
      "steps": [
        {"issue": {"template": "bump", "project": "backend", "values": [["package", "v0.5.0"], ["level", "minor"]], "subject": null}, "expect": {"outcome": "refused", "value": {"kind": "order", "detail": "value_not_in_list"}}}
      ],
      "bg_spawns": 0
    },
