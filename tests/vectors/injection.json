{
  "schema": 1,
  "card_launch": [
    {
      "name": "a value with an argument fragment",
      "family": "argument_fragment",
      "guards": "mutant-accept-any-value",
      "steps": [
        {"issue": {"template": "bump", "project": "backend", "values": [["package", "serde_json; calc.exe"], ["level", "minor"]], "subject": null}, "expect": {"outcome": "refused", "value": {"kind": "order", "detail": "value_not_in_list"}}}
      ],
      "bg_spawns": 0
    },
    {
      "name": "a value that is an option string",
      "family": "option_string",
      "guards": "mutant-accept-any-value",
      "steps": [
        {"issue": {"template": "bump", "project": "backend", "values": [["package", "--dangerously-skip-permissions"], ["level", "minor"]], "subject": null}, "expect": {"outcome": "refused", "value": {"kind": "order", "detail": "value_not_in_list"}}}
      ],
      "bg_spawns": 0
    },
