      "name": "a parameter that is an option",
      "family": "option_string",
      "steps": [
        {"issue": {"template": "bump", "project": "backend", "values": [["package", "serde_json"], ["level", "minor"], ["--model", "opus"]], "subject": null}, "expect": {"outcome": "refused", "value": {"kind": "order", "detail": "unknown_parameter"}}}
      ],
      "bg_spawns": 0
    },
    {
      "name": "a parameter given twice",
      "family": "outside_list",
      "steps": [
        {"issue": {"template": "bump", "project": "backend", "values": [["package", "serde_json"], ["level", "minor"], ["package", "tokio"]], "subject": null}, "expect": {"outcome": "refused", "value": {"kind": "order", "detail": "duplicate_parameter"}}}
      ],
      "bg_spawns": 0
    },
    {
