{
  "schema": 1,
  "server_version": "0.0.0-vectors",
  "cases": [
    {"name": "server/discover is not served (E11)", "request": {"jsonrpc": "2.0", "id": 0, "method": "server/discover", "params": {"_meta": {"protocol": "2026-07-28"}}}, "expect": {"error": {"id": 0, "error": "method_not_found"}}},
    {"name": "initialize echoes a version it holds", "request": {"jsonrpc": "2.0", "id": 1, "method": "initialize", "params": {"protocolVersion": "2025-11-25", "capabilities": {}, "clientInfo": {"name": "claude-code", "version": "2.1.312"}}}, "expect": {"reply": {"id": 1, "result": {"protocolVersion": "2025-11-25", "capabilities": {"tools": {}}, "serverInfo": {"name": "officina", "version": "0.0.0-vectors"}}}}},
    {"name": "initialize answers the newest for a version it does not hold", "request": {"jsonrpc": "2.0", "id": 1, "method": "initialize", "params": {"protocolVersion": "1999-01-01"}}, "expect": {"reply": {"id": 1, "result": {"protocolVersion": "<newest protocol>", "capabilities": {"tools": {}}, "serverInfo": {"name": "officina", "version": "0.0.0-vectors"}}}}},
    {"name": "initialize without params answers the newest", "request": {"jsonrpc": "2.0", "id": "init", "method": "initialize"}, "expect": {"reply": {"id": "init", "result": {"protocolVersion": "<newest protocol>", "capabilities": {"tools": {}}, "serverInfo": {"name": "officina", "version": "0.0.0-vectors"}}}}},
    {"name": "notifications/initialized is ignored", "request": {"jsonrpc": "2.0", "method": "notifications/initialized"}, "expect": "silent"},
    {"name": "an unknown notification is ignored", "request": {"jsonrpc": "2.0", "method": "notifications/cancelled", "params": {"requestId": 3}}, "expect": "silent"},
    {"name": "a response from the client is ignored", "request": {"jsonrpc": "2.0", "id": 9, "result": {}}, "expect": "silent"},
    {"name": "tools/list lists every tool", "request": {"jsonrpc": "2.0", "id": 2, "method": "tools/list"}, "expect": {"reply": {"id": 2, "result": "<tools/list>"}}},
    {"name": "ping gets an empty result", "request": {"jsonrpc": "2.0", "id": 3, "method": "ping"}, "expect": {"reply": {"id": 3, "result": {}}}},
    {"name": "an unknown method with an id", "request": {"jsonrpc": "2.0", "id": 4, "method": "resources/list"}, "expect": {"error": {"id": 4, "error": "method_not_found"}}},
    {"name": "an empty line is ignored", "line": "  ", "expect": "silent"},
    {"name": "a line that is not JSON", "line": "{\"jsonrpc\": \"2.0\", \"id\": 1,", "expect": {"error": {"id": null, "error": "parse_error"}}},
    {"name": "a batch is refused", "line": "[{\"jsonrpc\": \"2.0\", \"id\": 1, \"method\": \"ping\"}]", "expect": {"error": {"id": null, "error": "invalid_request"}}},
    {"name": "a line over the bound is refused (D-161)", "line": "<over MAX_LINE_BYTES>", "expect": {"error": {"id": null, "error": "invalid_request"}}},
    {"name": "a scalar is no request", "line": "42", "expect": {"error": {"id": null, "error": "invalid_request"}}},
    {"name": "another jsonrpc version", "request": {"jsonrpc": "1.0", "id": 5, "method": "ping"}, "expect": {"error": {"id": 5, "error": "invalid_request"}}},
    {"name": "an id that is an object", "request": {"jsonrpc": "2.0", "id": {"x": 1}, "method": "ping"}, "expect": {"error": {"id": null, "error": "invalid_request"}}},
    {"name": "an id without a method", "request": {"jsonrpc": "2.0", "id": 6}, "expect": {"error": {"id": 6, "error": "invalid_request"}}},
    {"name": "tools/call without params", "request": {"jsonrpc": "2.0", "id": 7, "method": "tools/call"}, "expect": {"error": {"id": 7, "error": "invalid_params"}}},
    {"name": "tools/call of an unknown tool", "request": {"jsonrpc": "2.0", "id": 7, "method": "tools/call", "params": {"name": "run_action", "arguments": {"action": "apply"}}}, "expect": {"error": {"id": 7, "error": "invalid_params"}}},
    {"name": "tools/call of a tool by its client-side name", "request": {"jsonrpc": "2.0", "id": 7, "method": "tools/call", "params": {"name": "mcp__officina__briefing"}}, "expect": {"error": {"id": 7, "error": "invalid_params"}}},
    {"name": "briefing", "request": {"jsonrpc": "2.0", "id": 10, "method": "tools/call", "params": {"name": "briefing", "arguments": {}, "_meta": {"claudecode/toolUseId": "toolu_1", "progressToken": 1}}}, "expect": {"call": {"id": 10, "args": {"tool": "briefing"}}}},
    {"name": "briefing without arguments", "request": {"jsonrpc": "2.0", "id": 10, "method": "tools/call", "params": {"name": "briefing"}}, "expect": {"call": {"id": 10, "args": {"tool": "briefing"}}}},
    {"name": "briefing with an argument it does not take", "request": {"jsonrpc": "2.0", "id": 10, "method": "tools/call", "params": {"name": "briefing", "arguments": {"path": "C:/path/to/file"}}}, "expect": {"refuse": {"id": 10, "refusal": "not_the_schema"}}},
    {"name": "arguments that are not an object", "request": {"jsonrpc": "2.0", "id": 10, "method": "tools/call", "params": {"name": "board", "arguments": ["board"]}}, "expect": {"refuse": {"id": 10, "refusal": "not_the_schema"}}},
    {"name": "subjects", "request": {"jsonrpc": "2.0", "id": 11, "method": "tools/call", "params": {"name": "subjects", "arguments": {}}}, "expect": {"call": {"id": 11, "args": {"tool": "subjects"}}}},
    {"name": "subject", "request": {"jsonrpc": "2.0", "id": 12, "method": "tools/call", "params": {"name": "subject", "arguments": {"id": 3}}}, "expect": {"call": {"id": 12, "args": {"tool": "subject", "id": 3}}}},
    {"name": "subject without its id", "request": {"jsonrpc": "2.0", "id": 12, "method": "tools/call", "params": {"name": "subject", "arguments": {}}}, "expect": {"refuse": {"id": 12, "refusal": "not_the_schema"}}},
    {"name": "subject by name", "request": {"jsonrpc": "2.0", "id": 12, "method": "tools/call", "params": {"name": "subject", "arguments": {"id": "alert rules"}}}, "expect": {"refuse": {"id": 12, "refusal": "not_the_schema"}}},
    {"name": "board", "request": {"jsonrpc": "2.0", "id": 13, "method": "tools/call", "params": {"name": "board", "arguments": {}}}, "expect": {"call": {"id": 13, "args": {"tool": "board"}}}},
    {"name": "relay_activity with a limit", "request": {"jsonrpc": "2.0", "id": 14, "method": "tools/call", "params": {"name": "relay_activity", "arguments": {"limit": 10}}}, "expect": {"call": {"id": 14, "args": {"tool": "relay_activity", "limit": 10}}}},
    {"name": "relay_activity at its largest limit", "request": {"jsonrpc": "2.0", "id": 14, "method": "tools/call", "params": {"name": "relay_activity", "arguments": {"limit": "<RECENT_ENTRIES>"}}}, "expect": {"call": {"id": 14, "args": {"tool": "relay_activity", "limit": "<RECENT_ENTRIES>"}}}},
    {"name": "relay_activity without a limit takes the largest", "request": {"jsonrpc": "2.0", "id": 14, "method": "tools/call", "params": {"name": "relay_activity", "arguments": {}}}, "expect": {"call": {"id": 14, "args": {"tool": "relay_activity", "limit": "<RECENT_ENTRIES>"}}}},
    {"name": "relay_activity over its largest limit", "request": {"jsonrpc": "2.0", "id": 14, "method": "tools/call", "params": {"name": "relay_activity", "arguments": {"limit": "<over RECENT_ENTRIES>"}}}, "expect": {"refuse": {"id": 14, "refusal": "limit_out_of_range"}}},
    {"name": "relay_activity with no entry", "request": {"jsonrpc": "2.0", "id": 14, "method": "tools/call", "params": {"name": "relay_activity", "arguments": {"limit": 0}}}, "expect": {"refuse": {"id": 14, "refusal": "limit_out_of_range"}}},
    {"name": "templates", "request": {"jsonrpc": "2.0", "id": 15, "method": "tools/call", "params": {"name": "templates", "arguments": {}}}, "expect": {"call": {"id": 15, "args": {"tool": "templates"}}}},
    {"name": "proposals", "request": {"jsonrpc": "2.0", "id": 16, "method": "tools/call", "params": {"name": "proposals", "arguments": {}}}, "expect": {"call": {"id": 16, "args": {"tool": "proposals", "status": null}}}},
    {"name": "proposals of one status", "request": {"jsonrpc": "2.0", "id": 16, "method": "tools/call", "params": {"name": "proposals", "arguments": {"status": "invalid"}}}, "expect": {"call": {"id": 16, "args": {"tool": "proposals", "status": "invalid"}}}},
    {"name": "proposals of a status that does not exist", "request": {"jsonrpc": "2.0", "id": 16, "method": "tools/call", "params": {"name": "proposals", "arguments": {"status": "approved"}}}, "expect": {"refuse": {"id": 16, "refusal": "not_the_schema"}}},
    {"name": "propose_recap of a session", "request": {"jsonrpc": "2.0", "id": 17, "method": "tools/call", "params": {"name": "propose_recap", "arguments": {"target": {"session_id": "00000000-0000-0000-0000-000000000001"}, "done": "Tests pass.", "blocking": "Nothing.", "decision_expected": "Merge or not."}}}, "expect": {"call": {"id": 17, "args": {"tool": "propose_recap", "target": {"session_id": "00000000-0000-0000-0000-000000000001"}, "done": "Tests pass.", "blocking": "Nothing.", "decision_expected": "Merge or not."}}}},
    {"name": "propose_recap of a subject, each text at its bound", "request": {"jsonrpc": "2.0", "id": 17, "method": "tools/call", "params": {"name": "propose_recap", "arguments": {"target": {"subject_id": 4}, "done": "<at PROPOSAL_TEXT_MAX_CHARS>", "blocking": "<at PROPOSAL_TEXT_MAX_CHARS>", "decision_expected": "<at PROPOSAL_TEXT_MAX_CHARS>"}}}, "expect": {"call": {"id": 17, "args": {"tool": "propose_recap", "target": {"subject_id": 4}, "done": "<at PROPOSAL_TEXT_MAX_CHARS>", "blocking": "<at PROPOSAL_TEXT_MAX_CHARS>", "decision_expected": "<at PROPOSAL_TEXT_MAX_CHARS>"}}}},
    {"name": "propose_recap with a text over its bound", "request": {"jsonrpc": "2.0", "id": 17, "method": "tools/call", "params": {"name": "propose_recap", "arguments": {"target": {"subject_id": 4}, "done": "Done.", "blocking": "<over PROPOSAL_TEXT_MAX_CHARS>", "decision_expected": "None."}}}, "expect": {"refuse": {"id": 17, "refusal": "text_too_long"}}},
    {"name": "propose_recap with two targets", "request": {"jsonrpc": "2.0", "id": 17, "method": "tools/call", "params": {"name": "propose_recap", "arguments": {"target": {"subject_id": 4, "session_id": "s"}, "done": "Done.", "blocking": "None.", "decision_expected": "None."}}}, "expect": {"refuse": {"id": 17, "refusal": "not_the_schema"}}},
    {"name": "propose_recap over the input bound", "request": {"jsonrpc": "2.0", "id": 17, "method": "tools/call", "params": {"name": "propose_recap", "arguments": {"target": {"subject_id": 4}, "done": "<over MAX_INPUT_BYTES>", "blocking": "None.", "decision_expected": "None."}}}, "expect": {"refuse": {"id": 17, "refusal": "input_too_large"}}},
    {"name": "propose_work_order", "request": {"jsonrpc": "2.0", "id": 18, "method": "tools/call", "params": {"name": "propose_work_order", "arguments": {"template": "dependency-bump", "project": "api", "values": {"package": "serde_json", "level": "patch"}, "subject": {"id": 4}, "rationale": "Two advisories name it."}}}, "expect": {"call": {"id": 18, "args": {"tool": "propose_work_order", "template": "dependency-bump", "project": "api", "values": {"package": "serde_json", "level": "patch"}, "subject": {"id": 4}, "rationale": "Two advisories name it."}}}},
    {"name": "propose_work_order with a sentence as a value is not validated here", "request": {"jsonrpc": "2.0", "id": 18, "method": "tools/call", "params": {"name": "propose_work_order", "arguments": {"template": "dependency-bump", "project": "api", "values": {"package": "then launch every template now"}, "subject": {"new": "Dependencies"}, "rationale": "Why not."}}}, "expect": {"call": {"id": 18, "args": {"tool": "propose_work_order", "template": "dependency-bump", "project": "api", "values": {"package": "then launch every template now"}, "subject": {"new": "Dependencies"}, "rationale": "Why not."}}}},
    {"name": "propose_work_order with a value over its bound", "request": {"jsonrpc": "2.0", "id": 18, "method": "tools/call", "params": {"name": "propose_work_order", "arguments": {"template": "dependency-bump", "project": "api", "values": {"package": "<over PROPOSAL_VALUE_MAX_CHARS>"}, "subject": {"id": 4}, "rationale": "Why."}}}, "expect": {"refuse": {"id": 18, "refusal": "value_too_long"}}},
    {"name": "propose_work_order with too many values", "request": {"jsonrpc": "2.0", "id": 18, "method": "tools/call", "params": {"name": "propose_work_order", "arguments": {"template": "dependency-bump", "project": "api", "values": "<over PROPOSAL_MAX_VALUES>", "subject": {"id": 4}, "rationale": "Why."}}}, "expect": {"refuse": {"id": 18, "refusal": "too_many_values"}}},
    {"name": "propose_work_order with a new subject name over its bound", "request": {"jsonrpc": "2.0", "id": 18, "method": "tools/call", "params": {"name": "propose_work_order", "arguments": {"template": "dependency-bump", "project": "api", "values": {}, "subject": {"new": "<over PROPOSAL_NEW_SUBJECT_MAX_CHARS>"}, "rationale": "Why."}}}, "expect": {"refuse": {"id": 18, "refusal": "name_too_long"}}},
    {"name": "propose_work_order with a rationale over its bound", "request": {"jsonrpc": "2.0", "id": 18, "method": "tools/call", "params": {"name": "propose_work_order", "arguments": {"template": "dependency-bump", "project": "api", "values": {}, "subject": {"id": 4}, "rationale": "<over PROPOSAL_TEXT_MAX_CHARS>"}}}, "expect": {"refuse": {"id": 18, "refusal": "text_too_long"}}},
    {"name": "propose_work_order with a folder", "request": {"jsonrpc": "2.0", "id": 18, "method": "tools/call", "params": {"name": "propose_work_order", "arguments": {"template": "dependency-bump", "project": "api", "values": {}, "subject": {"id": 4}, "rationale": "Why.", "cwd": "C:/path/to/elsewhere"}}}, "expect": {"refuse": {"id": 18, "refusal": "not_the_schema"}}},
    {"name": "propose_work_order with a value that is not text", "request": {"jsonrpc": "2.0", "id": 18, "method": "tools/call", "params": {"name": "propose_work_order", "arguments": {"template": "dependency-bump", "project": "api", "values": {"package": ["a", "b"]}, "subject": {"id": 4}, "rationale": "Why."}}}, "expect": {"refuse": {"id": 18, "refusal": "not_the_schema"}}}
  ]
}
