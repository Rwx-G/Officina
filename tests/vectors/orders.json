      "expect": {"card": {"name": "release-notes-2", "seq": 2, "argv": ["--bg", "--name", "release-notes-2", "--", "Draft the release notes for v0.4.0.\nKeep \"Unreleased\" as it is."], "cwd": "D:/path/to/Docs-Site", "subject": {"kind": "new", "value": "release-notes"}, "state": "open"}}
