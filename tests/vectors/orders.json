      "project": "backend",
      "values": [["package", "serde_json"], ["level", "minor"]],
      "snapshot_template": {"description": "Bump one dependency and fix what breaks", "projects": ["backend", "lab"], "prompt": "Bump {package} {level}}.", "params": {"level": ["minor", "patch"], "package": ["@scope/pkg", "serde_json", "tokio-util"]}, "model": "sonnet"},
      "expect": {"refused": "unrenderable_prompt"}
    },
    {
