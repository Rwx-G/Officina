      "template": "dependency-bump",
      "project": "Docs Site",
      "values": [["package", "serde_json"], ["level", "minor"]],
      "expect": {"refused": "project_not_allowed"}
    },
    {
      "name": "the project's name with a capital letter",
      "template": "dependency-bump",
      "project": "Backend",
      "values": [["package", "serde_json"], ["level", "minor"]],
