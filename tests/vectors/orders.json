    {"name": "a launch every check passes", "launch": {}, "expect": "launched"},
    {"name": "an unknown card", "launch": {"card": "unknown"}, "expect": {"refused": "unknown_card"}},
    {"name": "a superseded card", "launch": {"card": "superseded"}, "expect": {"refused": "superseded"}},
    {"name": "a consumed card, a double click", "launch": {"card": "consumed"}, "expect": {"refused": "consumed"}},
