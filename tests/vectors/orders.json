      "seq": 3,
      "subjects": [],
      "expect": {"card": {"name": "dependency-bump-3", "seq": 3, "argv": ["--bg", "--name", "dependency-bump-3", "--model", "sonnet", "--", "Bump serde_json to its latest minor release, run the tests, fix what breaks, commit."], "cwd": "C:/path/to/floor/work/Backend", "subject": {"kind": "new", "value": "dependency-bump"}, "state": "open"}}
