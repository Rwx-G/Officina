{
  "schema": 1,
  "floor_path": "C:/path/to/floor/officina.toml",
  "floor": "schema = 2\n[[project]]\nname = \"backend\"\npath = \"work/Backend\"\n[[project]]\nname = \"Docs Site\"\npath = \"D:/path/to/Docs-Site\"\n[[project]]\nname = \"lab\"\npath = \"Lab\"\n[[template]]\nname = \"dependency-bump\"\ndescription = \"Bump one dependency and fix what breaks\"\nprojects = [\"backend\", \"lab\"]\nprompt = \"Bump {package} to its latest {level} release, run the tests, fix what breaks, commit.\"\nmodel = \"sonnet\"\n[template.params.package]\nvalues = [\"serde_json\", \"tokio-util\", \"@scope/pkg\"]\n[template.params.level]\nvalues = [\"patch\", \"minor\"]\n[[template]]\nname = \"release-notes\"\ndescription = \"Draft the release notes\"\nprojects = [\"Docs Site\"]\nprompt = \"Draft the release notes for {version}.\\nKeep \\\"Unreleased\\\" as it is.\"\n[template.params.version]\nvalues = [\"v0.4.0\", \"v0.5.0\"]\n",
  "validate": [
    {
      "name": "an order in a project relative to the floor, its folder in the declared spelling",
      "template": "dependency-bump",
      "project": "backend",
      "values": [["package", "serde_json"], ["level", "minor"]],
      "expect": {"order": {"template": "dependency-bump", "project": "backend", "project_folder": "C:/path/to/floor/work/Backend", "values": {"level": "minor", "package": "serde_json"}, "prompt": "Bump serde_json to its latest minor release, run the tests, fix what breaks, commit.", "prompt_sha256": "27aeff79043c548dbe4fcb935ab02442db571f40c8ab9a06b592d59a21716957", "model": "sonnet"}}
    },
    {
      "name": "the pairs in another order give the same order",
      "template": "dependency-bump",
      "project": "lab",
      "values": [["level", "patch"], ["package", "@scope/pkg"]],
      "expect": {"order": {"template": "dependency-bump", "project": "lab", "project_folder": "C:/path/to/floor/Lab", "values": {"level": "patch", "package": "@scope/pkg"}, "prompt": "Bump @scope/pkg to its latest patch release, run the tests, fix what breaks, commit.", "prompt_sha256": "d1ba81fe547606daf54ecd788c5a09b551c2cb4aa0e7573d2c51b2ee58c4d9b2", "model": "sonnet"}}
    },
    {
      "name": "an absolute project folder, a multi-line prompt, no model",
      "template": "release-notes",
      "project": "Docs Site",
      "values": [["version", "v0.5.0"]],
      "expect": {"order": {"template": "release-notes", "project": "Docs Site", "project_folder": "D:/path/to/Docs-Site", "values": {"version": "v0.5.0"}, "prompt": "Draft the release notes for v0.5.0.\nKeep \"Unreleased\" as it is.", "prompt_sha256": "c0c88ef13083bc91443222f4af4de61404f6f749e5689a8962bcb81fc7aa914b", "model": null}}
    },
    {
