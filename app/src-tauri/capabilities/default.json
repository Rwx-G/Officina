{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The board window may call Officina's own commands, listen to its events and pin itself on top; nothing else (no shell, filesystem, HTTP or opener access).",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-always-on-top",
    "allow-get-board",
    "allow-get-relay",
    "allow-refresh",
    "allow-focus",
    "allow-report-wrong-window",
    "allow-copy-attach-command",
    "allow-approve-catalogue",
    "allow-decide-approval",
    "allow-set-relay-stopped",
    "allow-acknowledge-anomaly",
    "allow-get-registry",
    "allow-list-archived",
    "allow-create-subject",
    "allow-rename-subject",
    "allow-merge-subjects",
    "allow-file-sessions",
    "allow-archive-subject",
    "allow-reopen-subject",
    "allow-confirm-triage",
    "allow-evaluate-triage-model",
    "allow-set-triage-model",
    "allow-set-auto-archive",
    "allow-set-auto-approval",
    "allow-set-auto-mode",
    "allow-mark-should-not-have-run",
    "allow-settle-session",
    "allow-list-discarded",
    "allow-issue-card",
    "allow-edit-card",
    "allow-issue-card-from-proposal",
    "allow-dismiss-proposal",
    "allow-launch-work-order",
    "allow-get-orchestrator",
    "allow-mark-briefing-read",
    "allow-start-orchestrator",
    "allow-open-meeting",
    "allow-send-answer"
  ]
}
